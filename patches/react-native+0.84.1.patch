diff --git a/node_modules/react-native/ReactAndroid/cmake-utils/ReactNative-application.cmake b/node_modules/react-native/ReactAndroid/cmake-utils/ReactNative-application.cmake
index baa0fef..5e2ef7a 100644
--- a/node_modules/react-native/ReactAndroid/cmake-utils/ReactNative-application.cmake
+++ b/node_modules/react-native/ReactAndroid/cmake-utils/ReactNative-application.cmake
@@ -24,6 +24,14 @@ include(${CMAKE_CURRENT_LIST_DIR}/folly-flags.cmake)
 set(REACT_COMMON_DIR ${REACT_ANDROID_DIR}/../ReactCommon)
 include(${REACT_COMMON_DIR}/cmake-utils/react-native-flags.cmake)
 
+# WORKAROUND (Windows/NDK 26): the prebuilt react-android prefab headers use
+# std::format, which this NDK's libc++ doesn't provide, breaking every
+# autolinked codegen target that includes graphicsConversions.h. The
+# ReactCommon SOURCE tree (patched via patch-package to use std::to_string)
+# is the same version as the prefab copy, so shadow the prefab include dir
+# with it for the app target and all autolinked/codegen subdirectories.
+include_directories(BEFORE SYSTEM ${REACT_COMMON_DIR})
+
 # If you have ccache installed, we're going to honor it.
 find_program(CCACHE_FOUND ccache)
 if(CCACHE_FOUND)
@@ -33,7 +41,8 @@ endif(CCACHE_FOUND)
 
 # If the user toolchain supports IPO, we enable it for the app build
 include(CheckIPOSupported)
-check_ipo_supported(RESULT IPO_SUPPORT)
+# check_ipo_supported(RESULT IPO_SUPPORT)
+set(IPO_SUPPORT FALSE)
 if (IPO_SUPPORT)
   set(CMAKE_INTERPROCEDURAL_OPTIMIZATION TRUE)
 endif()
diff --git a/node_modules/react-native/ReactCommon/react/renderer/core/graphicsConversions.h b/node_modules/react-native/ReactCommon/react/renderer/core/graphicsConversions.h
