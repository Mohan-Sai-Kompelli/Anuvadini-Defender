[Unit]
Description=ApexMonitor Enterprise Hub
After=network.target

[Service]
Type=simple
User=isldev
WorkingDirectory=/home/isldev/monitor_system
ExecStart=/home/isldev/monitor_system/.venv/bin/python3 -m uvicorn server.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
