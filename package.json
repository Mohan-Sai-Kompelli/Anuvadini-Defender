{
  "name": "natsattendance",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "adb-reverse": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:5001 tcp:5001 && adb reverse tcp:50011 tcp:50011",
    "prestart": "npm run adb-reverse",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "build:android": "cd android && gradlew assembleDebug --no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a,armeabi-v7a",
    "build:ios": "cd ios && xcodebuild -workspace NATS Attendance.xcworkspace -scheme NATS Attendance -configuration Debug -sdk iphonesimulator CC=clang CPLUSPLUS=clang++ LD=clang LDPLUSPLUS=clang++ GCC_OPTIMIZATION_LEVEL=0 GCC_PRECOMPILE_PREFIX_HEADER=YES ASSETCATALOG_COMPILER_OPTIMIZATION=time DEBUG_INFORMATION_FORMAT=dwarf COMPILER_INDEX_STORE_ENABLE=NO",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "postinstall": "node scripts/postinstall.js",
    "install-skia-libs": "node scripts/copy-skia-native-libs.js"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@nozbe/watermelondb": "^0.28.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.5",
    "@react-native-firebase/app": "^23.7.0",
    "@react-native-firebase/messaging": "^23.7.0",
    "@react-native-ml-kit/face-detection": "^2.0.1",
    "@react-native-picker/picker": "^2.7.5",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/core": "6.4.17",
    "@react-navigation/elements": "^1.3.31",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.11.0",
    "@shopify/react-native-skia": "2.5.3",
    "all": "^0.0.0",
    "color": "^4.2.3",
    "concurrently": "^10.0.3",
    "eventemitter3": "^4.0.7",
    "invariant": "^2.2.4",
    "lucide-react-native": "^1.17.0",
    "memoize-one": "^5.2.1",
    "nullthrows": "^1.1.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "react": "19.2.3",
    "react-native": "0.84.1",
    "react-native-audio-recorder-player": "^3.6.14",
    "react-native-background-actions": "^4.0.1",
    "react-native-device-info": "^14.0.4",
