PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.tl0ib5d.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
# Biometric app's DB (shared local Mongo, different db name) — every successful
# attendance mark is mirrored into its `attendances` collection, and status/history
# is read from it too. Defaults to mongodb://127.0.0.1:27017/biometric.
BIOMETRIC_MONGODB_URI=mongodb://127.0.0.1:27017/biometric
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d
NODE_ENV=development 
# --- Anuvadini Defender (workstation monitoring engine, ../defender) ---
# Where the Python Defender service listens. Admin traffic reaches it only through /api/defender.
# DEFENDER_URL=http://127.0.0.1:8055
# By default this API server starts `python main.py` from ../defender when it is not already running.
# DEFENDER_AUTOSTART=1 (default). Set 0 to disable.
# DEFENDER_PYTHON=python

# --- Face recognition service (../face-back) ---
# The API server starts it automatically when nothing is listening on FACE_API_URL (default http://localhost:50011).
# FACE_AUTOSTART=0 disables that. FACE_PYTHON=python
